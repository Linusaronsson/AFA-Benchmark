# AFABench's locked Python environment, without the project code.
#
# The image holds Python 3.12.10 and the dependencies uv.lock pins (without the
# dev group) in /opt/venv. It includes the orchestration group, for the
# compute estimate (workflow/run.py -e), which plans with Snakemake and needs
# the libraries the orchestration environment lacks. The code is read from a checkout at run time through
# PYTHONPATH (containers/run.sh sets it), so a code change needs no rebuild and
# a uv.lock change does. Build it with containers/build.sbatch, on a machine of
# the architecture it is for: uv.lock pins different torch wheels for x86_64
# and aarch64, so one image cannot serve both.

Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.12.5-trixie-slim

%files
    pyproject.toml /opt/afabench/pyproject.toml
    uv.lock /opt/afabench/uv.lock

%post
    set -eu
    # Provenance records the checkout's commit through git; without it every
    # run would silently record none. ca-certificates is only a recommends of
    # git, and W&B's Go core verifies TLS against the system store, not certifi.
    apt-get update
    apt-get install -y --no-install-recommends git ca-certificates
    rm -rf /var/lib/apt/lists/*
    cd /opt/afabench
    # pyproject.toml pins a patch release no distribution ships, so uv
    # downloads it into the image. Bytecode is compiled here because the image
    # is read-only at run time.
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_NO_CACHE=1
    uv python install 3.12.10
    UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never \
        UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 \
        uv sync --frozen --no-install-project --no-dev --group orchestration

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"
